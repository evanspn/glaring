def default_pods_dir():
    """./pods in the current directory (your own specs) wins over the bundled examples."""
    return str(Path.cwd() / "pods") if (Path.cwd() / "pods").is_dir() else str(ROOT / "pods")


def default_env_file(explicit=None):
    if explicit:
        return Path(explicit)
    for cand in (os.environ.get("GLARING_ENV"), Path.cwd() / ".env", ROOT / ".env"):
        if cand and Path(cand).is_file():
            return Path(cand)
    return Path.cwd() / ".env"


class Fail(Exception):
    pass


# ---------------------------------------------------------------- tiny YAML
def _scalar(s):
    s = s.strip()
    if s == "" or s == "~" or s == "null":
        return None
    if s[0] in "\"'" and s[-1] == s[0] and len(s) >= 2:
        return s[1:-1]
    if s[0] == "[" and s[-1] == "]":
        inner = s[1:-1].strip()
        return [_scalar(x) for x in inner.split(",")] if inner else []
    if s in ("true", "false"):
        return s == "true"
    if re.fullmatch(r"-?\d+", s):
        return int(s)
    return s


def _strip_comment(line):
    out, quote = [], None
    for i, ch in enumerate(line):
        if quote:
            if ch == quote:
                quote = None
        elif ch in "\"'":
            quote = ch
        elif ch == "#" and (i == 0 or line[i - 1] in " \t"):
            break
        out.append(ch)
    return "".join(out).rstrip()


def load_yaml(text):
    """Strict subset: nested maps (2-space indent), lists of scalars, inline
    [a, b] lists, quoted/plain scalars, # comments. Anything else is an error."""
    rows = []
    for n, raw in enumerate(text.splitlines(), 1):
        line = _strip_comment(raw)
        if not line.strip():
            continue
        if "\t" in line[: len(line) - len(line.lstrip())]:
            raise Fail(f"line {n}: tabs are not allowed")
        rows.append((len(line) - len(line.lstrip()), line.strip(), n))

    def block(i, indent):
        if i >= len(rows):
            return None, i
        if rows[i][1].startswith("- "):
            items = []
            while i < len(rows) and rows[i][0] == indent and rows[i][1].startswith("- "):
                items.append(_scalar(rows[i][1][2:]))
                i += 1
            return items, i
        out = {}
        while i < len(rows) and rows[i][0] == indent:
            _, content, n = rows[i]
            m = re.fullmatch(r"([A-Za-z0-9_.-]+):(?:\s+(.*))?", content)
            if not m:
                raise Fail(f"line {n}: expected 'key: value', got {content!r}")
            key, rest = m.group(1), m.group(2)
            i += 1
            if rest is not None and rest != "":
                out[key] = _scalar(rest)
            elif i < len(rows) and rows[i][0] > indent:
                out[key], i = block(i, rows[i][0])
            else:
                out[key] = None
        if i < len(rows) and rows[i][0] > indent:
            raise Fail(f"line {rows[i][2]}: unexpected indentation")
        return out, i

    value, i = block(0, rows[0][0]) if rows else ({}, 0)
    if i != len(rows):
        raise Fail(f"line {rows[i][2]}: could not parse")
    return value


# ---------------------------------------------------------------- pod specs
NAME_RE = re.compile(r"^[a-z][a-z0-9-]{0,30}$")
HOST_RE = re.compile(r"^\.?[a-z0-9]([a-z0-9.-]*[a-z0-9])?$")
IPV4_RE = re.compile(r"^\.?\d+\.\d+\.\d+\.\d+$")
REGION_RE = re.compile(r"^[a-z]{2}(-[a-z]+)+-\d$")
MODEL_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,100}$")
# Shared-tenant suffixes: allowing "*.suffix" would allow anyone's content there.
SHARED_SUFFIXES = (
    "github.io", "githubusercontent.com", "githubassets.com", "amazonaws.com", "cloudfront.net", "vercel.app",
    "netlify.app", "herokuapp.com", "azurewebsites.net", "blob.core.windows.net", "appspot.com", "pages.dev",
    "workers.dev", "web.app", "firebaseapp.com", "ngrok.io", "ngrok-free.app", "trycloudflare.com",
    "onrender.com", "fly.dev", "repl.co", "glitch.me", "surge.sh", "r2.dev", "cloudapp.azure.com",
)
TWO_LABEL_PUBLIC_SUFFIXES = ("co.uk", "org.uk", "ac.uk", "com.au", "co.jp", "co.nz", "com.br", "co.in")


def check_host(h, where, allow_wildcard=True):
    if not isinstance(h, str) or not HOST_RE.match(h) or ".." in h or IPV4_RE.match(h):
        raise Fail(f"{where}: bad host {h!r} (hostnames only, no IP literals; '.example.com' allows subdomains)")
    bare = h.lstrip(".")
    labels = bare.split(".")
    if len(labels) < 2 or not labels[-1].isalpha():
        raise Fail(f"{where}: host {h!r} needs at least two labels (e.g. api.example.com)")
    if h.startswith("."):
        if not allow_wildcard:
            raise Fail(f"{where}: wildcard host {h!r} not allowed here")
        if bare in TWO_LABEL_PUBLIC_SUFFIXES or any(bare == x or bare.endswith("." + x) for x in SHARED_SUFFIXES):
            raise Fail(f"{where}: wildcard {h!r} covers a shared-tenant or public suffix; name the exact host instead")
    return h

SECRET_RE = re.compile(r"^[A-Z][A-Z0-9_]*$")
MEM_RE = re.compile(r"^\d+[mg]$")
PROVIDERS = ("bedrock", "openai", "custom", "none")


HOME_DENY = (".ssh", ".aws", ".gnupg", ".config", ".docker", ".kube", ".npmrc", ".netrc", ".codex", ".claude",
             ".openrig", ".local/state", ".local/share", ".cache", ".azure", ".gcloud", "Library", ".colima", ".lima")
SYSTEM_DENY = ("/etc", "/proc", "/sys", "/dev", "/run", "/var/run", "/var/lib/docker", "/root", "/boot", "/private/etc",
               "/private/var/run", "/var/root")


def check_mount_source(host, path):
    """Resolve symlinks first, then refuse sockets, home and its ancestors,
    credential/state dirs, and system dirs. A read-only docker.sock is still
    host root, so sockets are refused outright."""
    import stat as _stat
    real = Path(os.path.realpath(host))
    if not real.exists():
        raise Fail(f"{path}: mount source {host} does not exist")
    if _stat.S_ISSOCK(real.stat().st_mode) or real.name.endswith(".sock"):
        raise Fail(f"{path}: refusing to mount socket {real}")
    home = Path(os.path.realpath(Path.home()))
    if real == home or real in home.parents or real == Path("/"):
        raise Fail(f"{path}: refusing to mount {real} (your home directory or an ancestor of it)")
    for d in HOME_DENY:
        deny = home / d
        if real == deny or deny in real.parents:
            raise Fail(f"{path}: refusing to mount {real} (credential/state directory)")
    state = Path(os.path.realpath(STATE))
    if real == state or state in real.parents or real in state.parents:
        raise Fail(f"{path}: refusing to mount glaring's own state directory")
    for d in SYSTEM_DENY:
        dd = Path(os.path.realpath(d))
        if real == dd or dd in real.parents:
            raise Fail(f"{path}: refusing to mount system path {real}")
    return real


def load_pod(path):
    spec = load_yaml(Path(path).read_text()) or {}
    name = spec.get("name")
    if not isinstance(name, str) or not NAME_RE.match(name):
        raise Fail(f"{path}: 'name' must match {NAME_RE.pattern}")
    spec.setdefault("image", POD_IMAGE_DEFAULT)
    spec["cpus"] = spec.get("cpus", 2)
    spec["memory"] = str(spec.get("memory", "4g"))
    spec["pids"] = int(spec.get("pids", 512))
    if not MEM_RE.match(spec["memory"]):
        raise Fail(f"{path}: memory must look like 512m or 4g")
    for key in ("egress", "secrets", "peers", "mounts"):
        spec[key] = spec.get(key) or []
        if not isinstance(spec[key], list):
            raise Fail(f"{path}: '{key}' must be a list")
    for h in spec["egress"]:
        check_host(h, f"{path}: egress")
    for s in spec["secrets"]:
        if not isinstance(s, str) or not SECRET_RE.match(s):
            raise Fail(f"{path}: bad secret name {s!r}")
    for p in spec["peers"]:
        if not isinstance(p, str) or not NAME_RE.match(p) or p == name:
            raise Fail(f"{path}: bad peer {p!r}")
    mounts = []
    for m in spec["mounts"]:
        parts = str(m).split(":")
        if len(parts) != 2 or not parts[1].startswith("/"):
            raise Fail(f"{path}: mount {m!r} must be 'host_path:/container/path' (always read-only)")
        host = Path(parts[0]).expanduser()
        if not host.is_absolute():
            host = ROOT / host
        mounts.append((check_mount_source(host, path), parts[1]))
    spec["_mounts"] = mounts
    model = spec.get("model") or {"provider": "none"}
    if model.get("provider") not in PROVIDERS:
        raise Fail(f"{path}: model.provider must be one of {PROVIDERS}")
    validate_model(model, f"{path}: model")
    spec["model"] = model
    spec["_warnings"] = []
    spec["_mcp"] = {}
    if spec.get("codex_config"):
        raw = Path(str(spec["codex_config"])).expanduser()
        cfg = Path(os.path.realpath(raw if raw.is_absolute() else ROOT / raw))
        check_mount_source(cfg, path)
        if not cfg.is_file() or cfg.stat().st_size > 64 * 1024:
            raise Fail(f"{path}: codex_config must be a regular file under 64 KB")
        spec["_mcp"], spec["_warnings"] = validate_codex_config(_load_toml(cfg), spec, f"{path}: codex_config")
    if spec.get("rig"):
        rig = Path(os.path.realpath(ROOT / str(spec["rig"])))
        rigs_root = Path(os.path.realpath(ROOT / "rigs"))
        if rigs_root not in rig.parents or rig.suffix != ".yaml":
            raise Fail(f"{path}: rig must be a .yaml file under {rigs_root}")
        spec["_rig"] = rig
    spec["_path"] = str(path)
    return spec


def load_pods(directory, names=None):
    files = sorted(Path(directory).glob("*.yaml"))
    if not files:
        raise Fail(f"no pod specs in {directory}")
    pods = {}
    for f in files:
        p = load_pod(f)
        if p["name"] in pods:
            raise Fail(f"duplicate pod name {p['name']}")
        pods[p["name"]] = p
    for p in pods.values():
        for peer in p["peers"]:
            if peer not in pods:
                raise Fail(f"pod {p['name']}: unknown peer {peer}")
    if names:
        missing = [n for n in names if n not in pods]
        if missing:
            raise Fail(f"unknown pod(s): {', '.join(missing)}")
        pods = {n: pods[n] for n in names}
    return pods


# ------------------------------------------------------------- model backend
def validate_model(model, where="model"):
    prov = model.get("provider")
    if prov == "bedrock":
        region = str(model.get("region", "us-west-2"))
        if not REGION_RE.match(region):
            raise Fail(f"{where}: bad AWS region {region!r}")
    if model.get("model") is not None and not MODEL_RE.match(str(model["model"])):
        raise Fail(f"{where}: bad model id {model['model']!r}")
    if prov == "custom":
        base = str(model.get("base_url", ""))
        u = urlsplit(base)
        if u.scheme != "https" or not u.hostname or u.username or u.password or u.port not in (None, 443):
            raise Fail(f"{where}: base_url must be https://host/... (no credentials, default port)")
        check_host(u.hostname, f"{where}.base_url", allow_wildcard=False)
        if not re.fullmatch(r"https://[a-z0-9.-]+(/[A-Za-z0-9._~/-]*)?", base):
            raise Fail(f"{where}: base_url has unsupported characters")
        if not SECRET_RE.match(str(model.get("env_key", "CUSTOM_API_KEY"))):
            raise Fail(f"{where}: env_key must be an env var name")


def toml_str(v):
    # A JSON string is a valid TOML basic string, except: JSON would emit
    # non-BMP characters as surrogate-pair escapes (invalid TOML), and leaves
    # DEL (0x7f) raw (not allowed in TOML).
    return json.dumps(str(v), ensure_ascii=False).replace("\x7f", "\\u007f")


def model_hosts(model):
    prov = model.get("provider")
    if prov == "bedrock":
        region = model.get("region", "us-west-2")
        return [f"bedrock-runtime.{region}.amazonaws.com", f"sts.{region}.amazonaws.com"]
    if prov == "openai":
        return ["api.openai.com", "auth.openai.com", "chatgpt.com"]
    if prov == "custom":
        m = re.match(r"https?://([^/:]+)", str(model.get("base_url", "")))
        return [m.group(1)] if m else []
    return []


def codex_toml(model):
    prov = model.get("provider")
    lines = ['# rendered by glaring; no secrets here', 'sandbox_mode = "danger-full-access"  # the container is the sandbox', 'approval_policy = "never"']
    if prov == "bedrock":
        lines += [
            f'model = {toml_str(model.get("model", "openai.gpt-5.5"))}',
            'model_provider = "amazon-bedrock"',
            "",
            "[model_providers.amazon-bedrock.aws]",
            f'region = {toml_str(model.get("region", "us-west-2"))}',
            'wire_api = "responses"',
        ]
    elif prov == "openai":
        if model.get("model"):
            lines.append(f'model = {toml_str(model["model"])}')
    elif prov == "custom":
        env_key = model.get("env_key", "CUSTOM_API_KEY")
        if not SECRET_RE.match(str(env_key)):
            raise Fail("model.env_key must be an env var name")
        lines += [
            f'model = {toml_str(model.get("model", "default"))}',
            'model_provider = "custom"',
            "",
            "[model_providers.custom]",
            'name = "custom"',
            f'base_url = {toml_str(model["base_url"])}',
            f'env_key = {toml_str(env_key)}',
            'wire_api = "responses"',
        ]
    return "\n".join(lines) + "\n" if prov != "none" else None



# ------------------------------------------------------------------ MCP / Codex TOML
MCP_STDIO_KEYS = {"command", "args", "env", "env_vars", "cwd", "startup_timeout_sec", "tool_timeout_sec", "enabled",
                  "required", "enabled_tools", "disabled_tools", "default_tools_approval_mode"}
MCP_HTTP_KEYS = {"url", "bearer_token_env_var", "http_headers", "env_http_headers", "startup_timeout_sec",
                 "tool_timeout_sec", "enabled", "required", "enabled_tools", "disabled_tools", "default_tools_approval_mode"}
MCP_NAME_RE = re.compile(r"^[A-Za-z0-9_-]{1,40}$")
INSTALLERS = {"npx", "uvx", "pipx", "pip", "pip3", "npm", "pnpm", "yarn", "bunx", "bun", "deno", "curl", "wget", "sh",
              "bash", "zsh", "dash", "python", "python3", "node", "docker", "podman", "sudo", "su", "env", "eval", "perl", "ruby"}
RUNTIMES_ALLOWED_WITH_SCRIPT = {"node", "python3", "python"}
SECRETISH_KEY_RE = re.compile(r"(TOKEN|KEY|SECRET|PASSWORD|PASSWD|CREDENTIAL|AUTH)", re.I)
SECRET_VALUE_RE = re.compile(r"(?i)(bearer\s+\S{8,}|[A-Za-z0-9+/_-]{32,}|(sk|pk|ghp|gho|ghs|xox[bap]|AKIA|ASIA)[-_A-Za-z0-9]{12,})")
POD_PATH_PREFIXES = ("/workspace/", "/home/pod/", "/opt/", "/usr/local/bin/", "/usr/bin/", "/rig/")
TOP_LEVEL_DENIED_HINT = ("glaring owns model, provider, sandbox, approvals and hooks; "
                         "a codex_config file may only contribute [mcp_servers.*]")


def _load_toml(path):
    try:
        import tomllib
    except ImportError:
        raise Fail("codex_config needs Python 3.11+ (stdlib tomllib) to validate the TOML safely")
    try:
        return tomllib.loads(Path(path).read_text())
    except (OSError, tomllib.TOMLDecodeError) as e:
        raise Fail(f"{path}: cannot parse TOML: {e}")


SECRET_FLAG_RE = re.compile(r"(?i)^--?[a-z0-9_-]*(token|key|secret|password|passwd|credential|auth|bearer|sig(nature)?)[a-z0-9_-]*$")
SECRET_PARAM_RE = re.compile(r"(?i)(token|key|secret|password|passwd|credential|auth|bearer|sig|signature)")
TOKENISH_RE = re.compile(r"[A-Za-z0-9+_=-]{32,}")
KNOWN_PREFIX_RE = re.compile(r"(?i)(bearer\s+\S{8,}|(sk|pk|ghp|gho|ghs|xox[bap]|AKIA|ASIA)[-_A-Za-z0-9]{12,})")


def _looks_secret_value(v):
    if v.startswith("/"):  # a path: only known token prefixes count
        return bool(KNOWN_PREFIX_RE.search(v))
    return bool(KNOWN_PREFIX_RE.search(v) or TOKENISH_RE.search(v))


def check_args_for_secrets(args, where):
    for i, a in enumerate(args):
        if "=" in a and a.startswith("-"):
            flag, val = a.split("=", 1)
            if SECRET_FLAG_RE.match(flag) and val:
                raise Fail(f"{where}: arg {flag}=... carries a literal secret; pass it through env_vars instead")
        elif SECRET_FLAG_RE.match(a) and i + 1 < len(args) and not args[i + 1].startswith("-"):
            raise Fail(f"{where}: {a} is followed by a literal value; pass secrets through env_vars instead")
        if _looks_secret_value(a):
            raise Fail(f"{where}: arg looks like a literal secret; pass it through env_vars instead")


def check_url_for_secrets(u, where):
    if u.fragment:
        raise Fail(f"{where}: url fragments are not allowed")
    for pair in filter(None, u.query.split("&")):
        name, _, val = pair.partition("=")
        if (SECRET_PARAM_RE.search(name) and val) or _looks_secret_value(val):
            raise Fail(f"{where}: url query carries a literal secret ({name}); use bearer_token_env_var or env_http_headers")
    for seg in u.path.split("/"):
        if _looks_secret_value(seg):
            raise Fail(f"{where}: url path segment looks like a literal secret; use an env-var header instead")


def _declared(name, secrets_list, where):
    if not isinstance(name, str) or not SECRET_RE.match(name):
        raise Fail(f"{where}: {name!r} is not an environment variable name")
    if name not in secrets_list:
        raise Fail(f"{where}: references ${name}, which this pod did not declare under secrets:")


def validate_codex_config(data, spec, where):
    """Return (servers, warnings). Only [mcp_servers.*] is accepted; anything that
    could weaken the boundary or clobber glaring's own provider config is refused."""
    extra = sorted(set(data) - {"mcp_servers"})
    if extra:
        raise Fail(f"{where}: top-level key(s) {extra} not allowed; {TOP_LEVEL_DENIED_HINT}")
    servers = data.get("mcp_servers") or {}
    if not isinstance(servers, dict):
        raise Fail(f"{where}: mcp_servers must be a table of servers")
    allow_install = bool(spec.get("allow_runtime_install"))
    egress = set(h.lstrip(".") for h in spec["egress"]) | set(model_hosts(spec["model"]))
    warnings = []
    clean = {}
    for name, srv in servers.items():
        w = f"{where}: mcp_servers.{name}"
        if not MCP_NAME_RE.match(name) or not isinstance(srv, dict):
            raise Fail(f"{w}: bad server name or shape")
        is_http = "url" in srv
        is_stdio = "command" in srv
        if is_http == is_stdio:
            raise Fail(f"{w}: exactly one of 'command' (stdio) or 'url' (HTTP) is required")
        allowed = MCP_HTTP_KEYS if is_http else MCP_STDIO_KEYS
        bad = sorted(set(srv) - allowed)
        if bad:
            hint = " (interactive auth is not supported in pods)" if "auth" in bad else ""
            raise Fail(f"{w}: unsupported key(s) {bad}{hint}")
        out = {}
        for k, v in srv.items():
            if k in ("startup_timeout_sec", "tool_timeout_sec"):
                if not isinstance(v, int) or isinstance(v, bool) or not 1 <= v <= 3600:
                    raise Fail(f"{w}.{k}: integer 1..3600")
            elif k in ("enabled", "required"):
                if not isinstance(v, bool):
                    raise Fail(f"{w}.{k}: boolean")
            elif k in ("args", "enabled_tools", "disabled_tools", "env_vars"):
                if not isinstance(v, list) or not all(isinstance(x, str) and "\n" not in x for x in v):
                    raise Fail(f"{w}.{k}: list of strings")
                if k == "env_vars":
                    for n in v:
                        _declared(n, spec["secrets"], f"{w}.env_vars")
                if k == "args":
                    check_args_for_secrets(v, f"{w}.args")
            elif k == "bearer_token_env_var":
                _declared(v, spec["secrets"], f"{w}.{k}")
            elif k == "env_http_headers":
                if not isinstance(v, dict):
                    raise Fail(f"{w}.{k}: table of header = VAR_NAME")
                for hname, var in v.items():
                    if not re.fullmatch(r"[A-Za-z0-9-]+", hname):
                        raise Fail(f"{w}.{k}: bad header name {hname!r}")
                    _declared(var, spec["secrets"], f"{w}.{k}.{hname}")
            elif k in ("env", "http_headers"):
                if not isinstance(v, dict) or not all(isinstance(x, str) for x in v.values()):
                    raise Fail(f"{w}.{k}: table of strings")
                for ek, ev in v.items():
                    if (SECRETISH_KEY_RE.search(ek) and ev) or SECRET_VALUE_RE.search(ev):
                        ref = "env_vars / bearer_token_env_var / env_http_headers"
                        raise Fail(f"{w}.{k}.{ek}: looks like a literal secret; reference an env var instead ({ref})")
            elif k == "default_tools_approval_mode":
                if v not in ("auto", "prompt", "approve"):
                    raise Fail(f"{w}.{k}: auto | prompt | approve")
            elif k == "cwd":
                if not isinstance(v, str) or ".." in v.split("/") or not v.startswith(POD_PATH_PREFIXES + ("/workspace",)):
                    raise Fail(f"{w}.cwd must be an absolute path inside the pod (/workspace, /home/pod, /opt)")
            elif k == "command":
                if not isinstance(v, str) or not v or "\n" in v or ".." in v.split("/"):
                    raise Fail(f"{w}.command: invalid")
                base = v.rsplit("/", 1)[-1]
                if v.startswith("/") and not v.startswith(POD_PATH_PREFIXES):
                    raise Fail(f"{w}.command: absolute path must be inside the pod ({', '.join(POD_PATH_PREFIXES)})")
                if base in INSTALLERS and not (allow_install or (base in RUNTIMES_ALLOWED_WITH_SCRIPT and srv.get("args")
                                               and str(srv["args"][0]).startswith(POD_PATH_PREFIXES) and not str(srv["args"][0]).startswith("-"))):
                    raise Fail(f"{w}.command: '{base}' can download or run arbitrary code. Bake the server into a derived "
                               "image (docs/mcp.md) or set allow_runtime_install: true in the pod spec")
            elif k == "url":
                u = urlsplit(str(v))
                if u.scheme != "https" or not u.hostname or u.username or u.password or u.port not in (None, 443):
                    raise Fail(f"{w}.url must be https://host/... (no credentials, default port)")
                check_host(u.hostname, f"{w}.url", allow_wildcard=False)
                check_url_for_secrets(u, f"{w}.url")
                if u.hostname not in egress:
                    warnings.append(f"{w}: host {u.hostname} is not in this pod's egress: list, so the proxy will block it")
            out[k] = v
        if allow_install and is_stdio and srv["command"].rsplit("/", 1)[-1] in INSTALLERS:
            if not ({"registry.npmjs.org", "pypi.org", "files.pythonhosted.org"} & egress):
                warnings.append(f"{w}: runtime install needs a registry host in egress: (e.g. registry.npmjs.org)")
        clean[name] = out
    return clean, warnings


def _toml_val(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, int):
        return str(v)
    if isinstance(v, str):
        return toml_str(v)
    if isinstance(v, list):
        return "[" + ", ".join(_toml_val(x) for x in v) + "]"
    raise Fail("unsupported TOML value")


def render_mcp(servers):
    """Re-render validated servers ourselves; the user's raw text is never copied."""
    out = []
    for name, srv in servers.items():
        out += ["", f"[mcp_servers.{name}]"]
        tables = {}
        for k, v in srv.items():
            if isinstance(v, dict):
                tables[k] = v
            else:
                out.append(f"{k} = {_toml_val(v)}")
        for k, tbl in tables.items():
            out += ["", f"[mcp_servers.{name}.{k}]"] + [f"{toml_str(a) if not re.fullmatch(r'[A-Za-z0-9_-]+', a) else a} = {_toml_val(b)}" for a, b in tbl.items()]
    return "\n".join(out) + "\n" if out else ""


def aws_credentials_text(profile):
    """Resolve the work profile ON THE HOST into short-lived keys. The pod
    never sees the profile, its config, the SSO cache or any long-lived key."""
    if not shutil.which("aws"):
        raise Fail("model.provider=bedrock needs the AWS CLI v2 on the host (aws configure export-credentials), "
                   "or put AWS_BEARER_TOKEN_BEDROCK in the pod's secrets")
    r = subprocess.run(["aws", "configure", "export-credentials", "--profile", profile, "--format", "env"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        raise Fail(f"could not export credentials for AWS profile {profile!r} (try 'aws sso login --profile {profile}')")
    env = {}
    for line in r.stdout.splitlines():
        m = re.match(r"(?:export )?(AWS_[A-Z_]+)=(.*)", line.strip())
        if m:
            env[m.group(1)] = m.group(2).strip("'\"")
    needed = ("AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY")
    if not all(k in env for k in needed):
        raise Fail("export-credentials returned no keys")
    if not env.get("AWS_SESSION_TOKEN"):
        raise Fail(f"AWS profile {profile!r} yields long-lived keys (no session token); refusing to copy them into a pod. "
                   "Use an SSO or assume-role profile (short-lived credentials).")
    out = ["[default]", f"aws_access_key_id = {env['AWS_ACCESS_KEY_ID']}", f"aws_secret_access_key = {env['AWS_SECRET_ACCESS_KEY']}"]
    out.append(f"aws_session_token = {env['AWS_SESSION_TOKEN']}")
    return "\n".join(out) + "\n"


# --------------------------------------------------------------------- docker
def run(args, check=True, capture=True, input_text=None):
    r = subprocess.run([DOCKER] + list(args), capture_output=capture, text=True, input=input_text)
    if check and r.returncode != 0:
        raise Fail(f"docker {' '.join(args[:3])} failed: {(r.stderr or '').strip()[:400]}")
    return r


def exists(kind, name):
    return run([kind, "inspect", name], check=False).returncode == 0


def ensure_network(name, internal):
    if not exists("network", name):
        run(["network", "create"] + (["--internal"] if internal else []) + [name])


def parse_env_file(path):
    env = {}
    if path and Path(path).exists():
        for line in Path(path).read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            env[k.strip()] = v.strip().strip("'\"")
    return env


def tokens():
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    f = STATE / "tokens.json"
    data = json.loads(f.read_text()) if f.exists() else {}
    return data, f


def pod_token(name):
    data, f = tokens()
    if name not in data:
        data[name] = secrets.token_hex(24)
        f.write_text(json.dumps(data))
        f.chmod(0o600)
    return data[name]


def cname(pod):
    return f"{PREFIX}-{pod}"


def egress_name(pod):
    return f"{PREFIX}-egress-{pod}"


def squid_conf(hosts):
    acl = "\n".join(f"acl allowed dstdomain -n {h}" for h in hosts) if hosts else "acl allowed dstdomain -n .invalid"
    return f"""# rendered by glaring: default deny, hostname allowlist, HTTPS only
http_port 3128
{acl}
acl SSL_ports port 443
acl CONNECT method CONNECT
http_access deny CONNECT !SSL_ports
http_access allow CONNECT allowed
http_access deny all
cache deny all
access_log stdio:/dev/stdout
cache_log /dev/stderr
pid_filename /tmp/squid.pid
coredump_dir /tmp
via off
forwarded_for delete
"""


def pod_dir(pod):
    d = STATE / "pods" / pod
    d.mkdir(parents=True, exist_ok=True)
    d.chmod(0o700)
    return d


def up_pod(pod, pods, envfile_vars, aws_profile, base_allow):
    spec = pods[pod]
    d = pod_dir(pod)
    model = spec["model"]
    hosts = sorted(set(base_allow + model_hosts(model) + spec["egress"]))
    (d / "squid.conf").write_text(squid_conf(hosts))
    (d / "squid.conf").chmod(0o644)
    toml = codex_toml(model)
    if spec.get("_mcp"):
        toml = (toml or "") + render_mcp(spec["_mcp"])
    if toml:
        (d / "codex.toml").write_text(toml)
        (d / "codex.toml").chmod(0o644)

    for nm in (cname(pod), egress_name(pod)):
        run(["rm", "-f", nm], check=False)
    eg_net = f"{PREFIX}-eg-{pod}"
    ensure_network(MESH, internal=True)
    ensure_network(OUT, internal=False)
    ensure_network(eg_net, internal=True)

    # proxy
    run(["create", "--name", egress_name(pod), "--network", eg_net, "--read-only",
         "--tmpfs", "/var/run:rw,size=8m", "--tmpfs", "/tmp:rw,size=16m", "--tmpfs", "/var/log/squid:rw,size=16m",
         "--tmpfs", "/var/spool/squid:rw,size=16m", "--cap-drop", "ALL", "--security-opt", "no-new-privileges",
         "--pids-limit", "128", "--memory", "256m", "--restart", "no", "--init",
         "-v", f"{d / 'squid.conf'}:/etc/squid/squid.conf:ro", PROXY_IMAGE])
    run(["network", "connect", OUT, egress_name(pod)])
    run(["start", egress_name(pod)])

    # secrets: only the names this pod declares
    env = {"GLARING_POD": pod, "OPENRIG_AUTH_BEARER_TOKEN": pod_token(pod)}
    peers = []
    for peer in spec["peers"]:
        var = f"PEER_{peer.upper().replace('-', '_')}_TOKEN"
        env[var] = pod_token(peer)
        peers.append(f"{peer}=http://{cname(peer)}:7433={var}")
    env["GLARING_PEERS"] = ";".join(peers)
    for s in spec["secrets"]:
        if s not in envfile_vars or envfile_vars[s] == "":
            print(f"warning: pod {pod}: secret {s} is not set in the env file", file=sys.stderr)
        else:
            env[s] = envfile_vars[s]
    proxy = f"http://{egress_name(pod)}:3128"
    no_proxy = ",".join(["localhost", "127.0.0.1"] + [cname(p) for p in spec["peers"]])
    env.update({"HTTPS_PROXY": proxy, "HTTP_PROXY": proxy, "https_proxy": proxy, "http_proxy": proxy,
                "NO_PROXY": no_proxy, "no_proxy": no_proxy})

    extra = []
    if model.get("provider") == "bedrock" and "AWS_BEARER_TOKEN_BEDROCK" not in spec["secrets"]:
        if not aws_profile:
            raise Fail(f"pod {pod} uses Bedrock: pass --aws-profile NAME (or set AWS_PROFILE)")
        cdir = d / "aws"
        cdir.mkdir(exist_ok=True)
        cdir.chmod(0o755)
        cred = cdir / "credentials"
        cred.write_text(aws_credentials_text(aws_profile))
        cred.chmod(0o644)  # parent dir 0700 keeps other host users out
        env["AWS_SHARED_CREDENTIALS_FILE"] = "/run/glaring/aws/credentials"
        env["AWS_REGION"] = model.get("region", "us-west-2")
        extra += ["-v", f"{cred}:/run/glaring/aws/credentials:ro"]
    if toml:
        extra += ["-v", f"{d / 'codex.toml'}:/etc/glaring/codex.toml:ro"]
    if spec.get("_rig"):
        if not spec["_rig"].is_file():
            raise Fail(f"pod {pod}: rig file {spec['rig']} not found")
        extra += ["-v", f"{spec['_rig']}:/rig/rig.yaml:ro"]
    for host, target in spec["_mounts"]:
        extra += ["-v", f"{host}:{target}:ro"]

    tmp = Path(tempfile.mkdtemp(prefix="glaring-env-"))
    tmp.chmod(0o700)
    envf = tmp / "env"
    try:
        envf.write_text("".join(f"{k}={v}\n" for k, v in env.items() if "\n" not in v))
        envf.chmod(0o600)
        run(["create", "--name", cname(pod), "--hostname", cname(pod), "--network", MESH, "--user", POD_UID,
             "--read-only", "--tmpfs", "/tmp:rw,nosuid,nodev,size=512m", "--tmpfs", "/run:rw,nosuid,nodev,size=16m",
             "--cap-drop", "ALL", "--security-opt", "no-new-privileges", "--pids-limit", str(spec["pids"]),
             "--memory", spec["memory"], "--memory-swap", spec["memory"], "--cpus", str(spec["cpus"]),
             "--init", "--restart", "no", "--log-driver", "json-file", "--log-opt", "max-size=10m", "--log-opt", "max-file=3",
             "--env-file", str(envf),
             "-v", f"{cname(pod)}-home:/home/pod", "-v", f"{cname(pod)}-ws:/workspace"] + extra + [spec["image"]])
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    run(["network", "connect", eg_net, cname(pod)])
    run(["start", cname(pod)])
    print(f"up   {pod}")


# ------------------------------------------------------------------- commands
def cmd_build(args):
    run(["build", "-t", POD_IMAGE_DEFAULT, str(ROOT / "image")], capture=False)
    run(["build", "-t", PROXY_IMAGE, str(ROOT / "proxy")], capture=False)


def cmd_up(args):
    pods = load_pods(args.pods, args.names)
    envfile = default_env_file(args.env_file)
    envvars = parse_env_file(envfile)
    if args.env_file and not Path(args.env_file).exists():
        raise Fail(f"env file {args.env_file} not found")
    base = []
    pol = ROOT / "policy" / "egress.yaml"
    if pol.exists():
        base = (load_yaml(pol.read_text()) or {}).get("allow") or []
    profile = args.aws_profile or os.environ.get("AWS_PROFILE")
    for name in pods:
        for w in pods[name]["_warnings"]:
            print(f"warning: {w}", file=sys.stderr)
        up_pod(name, pods, envvars, profile, base)


def cmd_down(args):
    pods = load_pods(args.pods, args.names)
    for name in pods:
        for nm in (cname(name), egress_name(name)):
            run(["rm", "-f", nm], check=False)
        run(["network", "rm", f"{PREFIX}-eg-{name}"], check=False)
        if args.purge:
            run(["volume", "rm", f"{cname(name)}-home", f"{cname(name)}-ws"], check=False)
            shutil.rmtree(STATE / "pods" / name, ignore_errors=True)
        print(f"down {name}")
    if not args.names:
        run(["network", "rm", MESH], check=False)
        run(["network", "rm", OUT], check=False)


def cmd_status(args):
    pods = load_pods(args.pods, args.names)
    print(f"{'POD':16} {'STATE':10} {'EGRESS PROXY':14} DAEMON")
    for name in pods:
        st = run(["inspect", "-f", "{{.State.Status}}", cname(name)], check=False)
        pr = run(["inspect", "-f", "{{.State.Status}}", egress_name(name)], check=False)
        state = st.stdout.strip() if st.returncode == 0 else "absent"
        daemon = "-"
        if state == "running":
            d = run(["exec", cname(name), "rig", "daemon", "status"], check=False)
            daemon = (d.stdout.strip().splitlines() or ["?"])[-1][:60]
        print(f"{name:16} {state:10} {(pr.stdout.strip() if pr.returncode == 0 else 'absent'):14} {daemon}")


def cmd_logs(args):
    target = egress_name(args.name) if args.proxy else cname(args.name)
    os.execvp(DOCKER, [DOCKER, "logs"] + (["-f"] if args.follow else []) + ["--tail", str(args.tail), target])


def cmd_exec(args):
    tty = ["-it"] if sys.stdin.isatty() else ["-i"]
    os.execvp(DOCKER, [DOCKER, "exec"] + tty + [cname(args.name)] + (args.cmd or ["bash"]))


def cmd_login(args):
    os.execvp(DOCKER, [DOCKER, "exec", "-it", cname(args.name), "codex", "login", "--device-auth"])


def cmd_refresh_creds(args):
    pods = load_pods(args.pods, args.names)
    profile = args.aws_profile or os.environ.get("AWS_PROFILE")
    for name, spec in pods.items():
        cred = pod_dir(name) / "aws" / "credentials"
        if spec["model"].get("provider") == "bedrock" and cred.exists():
            if not profile:
                raise Fail("pass --aws-profile or set AWS_PROFILE")
            with open(cred, "w") as fh:  # truncate in place: the bind mount follows the same inode
                fh.write(aws_credentials_text(profile))
            print(f"refreshed {name}")


def cmd_doctor(args):
    sys.path.insert(0, str(ROOT))
    import glaring_doctor as d
    rep, os_name = d.run_doctor(ROOT, default_env_file(args.env_file), args.pods, load_pods,
                                profile=args.aws_profile or os.environ.get("AWS_PROFILE"), offline=args.offline)
    if args.json:
        print(d.to_json(rep, os_name))
    else:
        color = sys.stdout.isatty() and "NO_COLOR" not in os.environ
        uni = (sys.stdout.encoding or "").lower().startswith("utf")
        print(d.render(rep, color, uni, args.fix))
    sys.exit(1 if rep.counts()[d.FAIL] else 0)


def cmd_test(args):
    os.execv("/bin/bash", ["/bin/bash", str(ROOT / "tests" / "escape.sh")] + (args.rest or []))


def main():
    ap = argparse.ArgumentParser(prog="glaring", description=__doc__.split("\n")[0])
    ap.add_argument("--pods", default=default_pods_dir(), help="directory of pod specs (default: ./pods if present, else the bundled examples)")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("build", help="build the pod and proxy images").set_defaults(fn=cmd_build)
    for nm, fn, h in (("up", cmd_up, "create and start pods (recreates containers; volumes persist)"),
                      ("down", cmd_down, "stop and remove pods"),
                      ("status", cmd_status, "show pod, proxy and daemon state"),
                      ("refresh-creds", cmd_refresh_creds, "re-export short-lived AWS keys into running Bedrock pods")):
        p = sub.add_parser(nm, help=h)
        p.add_argument("names", nargs="*", help="pod names (default: all)")
        if nm in ("up", "refresh-creds"):
            p.add_argument("--aws-profile", help="AWS profile to export short-lived credentials from (Bedrock pods)")
        if nm == "up":
            p.add_argument("--env-file", help="env file with scoped tokens (default: ./.env if present)")
        if nm == "down":
            p.add_argument("--purge", action="store_true", help="also delete the pod volumes (workspace, home)")
        p.set_defaults(fn=fn)
    p = sub.add_parser("doctor", help="check dependencies and environment (read-only)")
    p.add_argument("--json", action="store_true", help="machine-readable output")
    p.add_argument("--fix", action="store_true", help="also print a consolidated fix list")
    p.add_argument("--aws-profile", help="validate this AWS profile (Bedrock pods)")
    p.add_argument("--env-file", help="env file to check (default: ./.env)")
    p.add_argument("--offline", action="store_true", help="skip network reachability checks")
    p.set_defaults(fn=cmd_doctor)
    p = sub.add_parser("logs", help="container logs (kept outside the pod)")
    p.add_argument("name"); p.add_argument("--proxy", action="store_true", help="egress proxy access log")
    p.add_argument("-f", "--follow", action="store_true"); p.add_argument("--tail", type=int, default=100)
    p.set_defaults(fn=cmd_logs)
    p = sub.add_parser("exec", help="run a command in a pod (default: bash)")
    p.add_argument("name"); p.add_argument("cmd", nargs="*"); p.set_defaults(fn=cmd_exec)
    p = sub.add_parser("login", help="interactive Codex device login inside a pod (home setups)")
    p.add_argument("name"); p.set_defaults(fn=cmd_login)
    p = sub.add_parser("test", help="run the escape/exfil tests against the running example pods")
    p.add_argument("rest", nargs="*"); p.set_defaults(fn=cmd_test)
    args = ap.parse_args()
    try:
        args.fn(args)
    except Fail as e:
        print(f"glaring: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
