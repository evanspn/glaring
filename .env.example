# Copy to .env (gitignored AND dockerignored) and fill in. Names only here;
# never commit values. `glaring up` hands each pod ONLY the names listed under
# `secrets:` in its pod spec, via a temporary 0600 --env-file.

# Scoped GitHub token (fine-grained, only the repos this swarm needs).
GITHUB_TOKEN=
# Scoped Jira API token (+ the Jira host must be allowlisted in the pod spec).
JIRA_API_TOKEN=
JIRA_EMAIL=
# Home setups using an OpenAI API key instead of Bedrock:
OPENAI_API_KEY=
# Bedrock API key alternative to an AWS profile (optional):
AWS_BEARER_TOKEN_BEDROCK=
